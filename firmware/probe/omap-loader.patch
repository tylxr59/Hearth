+/* This experimental probe targets only the observed Nest port 1-1. */
+static bool hearth_target_port(libusb_device *dev)
+{
+  uint8_t ports[8];
+  if (libusb_get_bus_number(dev) != 1)
+    return false;
+  return libusb_get_port_numbers(dev, ports, sizeof(ports)) == 1 && ports[0] == 1;
+}
